+static void
+fpc_init_step_done_cb (FpiDeviceFpcMoc *self,
+                       void            *data,
+                       GError          *error)
+{
+  if (error)
+    {
+      fp_err ("%s error: %s", G_STRFUNC, error->message);
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  fpi_ssm_next_state (self->task_ssm);
+}
+
+static void
+fpc_init_auth_blob_cb (FpiDeviceFpcMoc *self,
+                       void            *data,
+                       GError          *error)
+{
+  gint32 status = 0;
+
+  if (!check_data (data, &error))
+    {
+      fp_err ("%s error: %s ", G_STRFUNC, error->message);
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  status = *((gint32 *) data);
+  if (status != 0)
+    {
+      error = fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                        "Session auth blob failed: %d",
+                                        status);
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  fpi_ssm_next_state (self->task_ssm);
+}
