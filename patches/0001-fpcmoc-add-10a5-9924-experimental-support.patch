+static void
+fpc_enroll_refresh_cb (FpiDeviceFpcMoc *self,
+                       void            *data,
+                       GError          *error)
+{
+  fpc_fid_data_t *fallback = NULL;
+  fpc_fid_data_t *selected = NULL;
+  pfpc_cmd_response_t presp = NULL;
+
+  if (!check_data (data, &error))
+    {
+      fp_err ("%s error: %s ", G_STRFUNC, error->message);
+      fpi_ssm_mark_failed (self->task_ssm, error);
+      return;
+    }
+
+  presp = (pfpc_cmd_response_t) data;
+  if (presp->evt_hdr.cmdid != FPC_EVT_FID_DATA ||
+      presp->evt_enum_fids.num_ids > FPC_TEMPLATES_MAX)
+    {
+      fpi_ssm_mark_failed (self->task_ssm,
+                           fpi_device_error_new (FP_DEVICE_ERROR_DATA_INVALID));
+      return;
+    }
+
+  for (int n = 0; n < presp->evt_enum_fids.num_ids; n++)
+    {
+      fpc_fid_data_t *fid_data = &presp->evt_enum_fids.fid_data[n];
+
+      if (!fpc_identity_matches (self,
+                                 fid_data->subfactor,
+                                 fid_data->identity_type,
+                                 fid_data->identity_size))
+        continue;
+
+      if (fid_data->identity_type == 2 &&
+          fid_data->identity_size == 16 &&
+          self->pending_enroll_identity_valid &&
+          memcmp (fid_data->identity, self->pending_enroll_identity, 16) == 0)
+        {
+          fallback = fid_data;
+          continue;
+        }
+
+      if (fid_data->identity_type == 4 && fid_data->identity_size == 32)
+        {
+          selected = fid_data;
+          break;
+        }
     }
+
+  if (selected == NULL)
+    selected = fallback;
+
+  if (selected != NULL)
+    {
+      FpPrint *print = NULL;
+
+      fpi_device_get_enroll_data (FP_DEVICE (self), &print);
+      fpc_print_set_identity_data (self,
+                                   print,
+                                   selected->subfactor,
+                                   selected->identity_type,
+                                   selected->identity,
+                                   selected->identity_size,
+                                   FALSE);
+      fp_info ("FPC9924 enrollment result refreshed to type=%u size=%u",
+               selected->identity_type,
+               selected->identity_size);
+    }
+
+  fpi_ssm_mark_completed (self->task_ssm);
 }
 
 
